#!/usr/bin/env bash
# PostToolUse hook — logs every tool call to ~/.claude/superpowers-logs/YYYY-MM-DD.jsonl
# Matcher: empty (matches all tools). Runs async so it doesn't block the agent.

set -euo pipefail

# --- Toggle: only log when marker file exists ---
LOG_DIR="$HOME/.claude/superpowers-logs"
if [[ ! -f "$LOG_DIR/.enabled" ]]; then
    exit 0
fi

# --- Read plugin version from plugin.json ---
PLUGIN_VERSION=""
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-}"
if [[ -n "$PLUGIN_ROOT" && -f "$PLUGIN_ROOT/.claude-plugin/plugin.json" ]]; then
    PLUGIN_VERSION=$(python3 -c "
import json,sys
try:
    with open(sys.argv[1]) as f: print(json.load(f).get('version',''))
except: pass
" "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null || true)
fi

# --- Read stdin into variable so we can use it twice ---
input=$(cat || true)

# --- Parse and format via python3 ---
echo "$input" | python3 -c "
import sys, json, os
from datetime import datetime

try:
    raw = sys.stdin.read()
    data = json.loads(raw)
except Exception:
    sys.exit(0)

tool_name = data.get('tool_name', '')
tool_input = data.get('tool_input', {})
session_id = data.get('session_id', '')
cwd = data.get('cwd', '')
duration_ms = data.get('duration_ms')

# Use explicit None check — truthy checks ('or') skip empty dicts/strings
tool_result = data.get('tool_response')
if tool_result is None:
    tool_result = data.get('tool_result')
if tool_result is None:
    tool_result = data.get('result')
if tool_result is None:
    tool_result = data.get('output')
if tool_result is None:
    tool_result = ''

# Build log entry
entry = {
    'ts': datetime.now().astimezone().isoformat(timespec='seconds'),
    'session_id': session_id,
    'tool_name': tool_name,
    'tool_input': tool_input,
    'cwd': cwd,
}

# Plugin version (passed from bash env)
plugin_version = sys.argv[1] if len(sys.argv) > 1 else ''
if plugin_version:
    entry['plugin_version'] = plugin_version

# Duration when available
if duration_ms is not None:
    entry['duration_ms'] = duration_ms

# Skill-specific: extract skill_name to top level for easy grepping
if tool_name == 'Skill':
    skill = tool_input.get('skill', '')
    if skill:
        entry['skill_name'] = skill

# tool_result handling: keep length + truncated preview
if isinstance(tool_result, str):
    r_len = len(tool_result)
elif isinstance(tool_result, list):
    r_len = sum(len(json.dumps(b, ensure_ascii=False)) for b in tool_result)
elif isinstance(tool_result, dict):
    r_len = len(json.dumps(tool_result, ensure_ascii=False))
else:
    r_len = len(str(tool_result)) if tool_result else 0

entry['result_len'] = r_len

if r_len == 0:
    entry['result_preview'] = ''
elif isinstance(tool_result, str):
    if len(tool_result) <= 500:
        entry['result_preview'] = tool_result
    else:
        entry['result_preview'] = tool_result[:400] + '...[truncated, total=' + str(r_len) + ']'
else:
    dumped = json.dumps(tool_result, ensure_ascii=False)
    if len(dumped) <= 500:
        entry['result_preview'] = dumped
    else:
        entry['result_preview'] = dumped[:400] + '...[truncated, total=' + str(r_len) + ']'

# Determine log file path (daily rotation)
log_dir = os.path.expanduser('~/.claude/superpowers-logs')
today = datetime.now().strftime('%Y-%m-%d')
log_file = os.path.join(log_dir, today + '.jsonl')

# Append as single line JSON — use separators to minimize whitespace
line = json.dumps(entry, ensure_ascii=False, separators=(',', ':'))
with open(log_file, 'a', encoding='utf-8') as f:
    f.write(line + '\n')
" "$PLUGIN_VERSION" 2>/dev/null || true

exit 0
